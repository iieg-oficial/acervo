COMPOSE_PROJECT_NAME=acervo-dev

# Version de SeaweedFS (chrislusf/seaweedfs:<tag>)
SEAWEEDFS_VERSION=4.23

# Puertos expuestos al host en dev
ACERVO_S3_PORT=8333
ACERVO_FILER_PORT=8888
ACERVO_METRICS_PORT=9091

# Credenciales del usuario admin de SeaweedFS
ACERVO_ADMIN_ACCESS_KEY=acervo-admin
ACERVO_ADMIN_SECRET_KEY=devsecret_replace_for_random_32_chars

# Buckets del entorno dev (los mismos del ecosistema para validar firma sigv4)
ACERVO_BUCKETS="portal mapalab mariachi sieej dataengine iieg"

# Subset publico (anonymous Read)
ACERVO_PUBLIC_BUCKETS="portal mapalab iieg"
