COMPOSE_PROJECT_NAME=acervo

# Version de SeaweedFS (chrislusf/seaweedfs:<tag>)
SEAWEEDFS_VERSION=4.23

# Puerto de la API S3 expuesto al host de la VM (el gateway-hub la consume por DNS interno de Docker)
ACERVO_S3_PORT=8333

# Credenciales del usuario admin (puede leer/escribir cualquier bucket). Se usan para backup, restore y migracion.
# Generar con: openssl rand -base64 24
ACERVO_ADMIN_ACCESS_KEY=acervo-admin
ACERVO_ADMIN_SECRET_KEY=replace_with_random_32_chars

# Buckets canonicos del ecosistema. Se generara un identity <bucket>-user por cada uno.
ACERVO_BUCKETS="portal mapalab mariachi sieej dataengine iieg"

# Subset de buckets con anonymous Read habilitado.
ACERVO_PUBLIC_BUCKETS="portal mapalab iieg"

# Backups (corren via cron mensual; ver Makefile cron-install)
BACKUP_DIR=/backups/acervo
BACKUP_RETENTION_MONTHS=2

# Rotacion one-shot de credenciales (profile init). Opcionales.
ROTATE_FLAG=<0|1>
TARGET_BUCKET=<bucket>

# Solo se setean durante la migracion one-shot desde MinIO. Despues se borran.
# MIGRATE_MINIO_ACCESS_KEY=old_root_key
# MIGRATE_MINIO_SECRET_KEY=old_root_secret
# MIGRATE_MINIO_VOLUME=acervo_minio_data
