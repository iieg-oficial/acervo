COMPOSE_PROJECT_NAME=acervo

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BROWSER_REDIRECT_URL=https://YOUR_SERVER_IP/console
MINIO_SERVER_URL=https://YOUR_SERVER_IP

TRUSTED_PROXIES=<ip>/16,<ip>/24
CONSOLE_ALLOWED_IPS=<CIDR>/24,<ip>
ALLOWED_SERVER_IPS=IP_MAPALAB,IP_DATEENGINE,IP_PORTAL

BACKUP_DIR=/backups/acervo
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_WEEKS=4
BACKUP_RETENTION_MONTHS=3
