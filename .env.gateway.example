COMPOSE_PROJECT_NAME=name_project

MINIO_API_PORT=port
MINIO_CONSOLE_PORT=port

MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key

MINIO_BROWSER_REDIRECT_URL=https://YOUR_DOMAIN/acervo/console

# pgsty/minio restauro la consola embebida que el upstream removio en mayo 2025.
# En modo gateway el equipo de MV no filtra /acervo/console/* por IP, asi que
# se apaga aqui. Admin via `docker exec acervo-minio mc ...` o tunel SSH.
MINIO_BROWSER=off

MINIO_PROMETHEUS_AUTH_TYPE=public/jwt
MINIO_BUCKETS="bucket1 bucket2 bucket3"
ACERVO_PUBLIC_BUCKETS="bucket1 bucket3"

BACKUP_DIR=path
BACKUP_RETENTION_MONTHS=number
