COMPOSE_PROJECT_NAME=name_project

MINIO_API_PORT=port
MINIO_CONSOLE_PORT=port

MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
# Path debe coincidir con el location en gateway-hub (location ^~ /acervo/console/).
# Sin prefijo /acervo/, MinIO genera URLs absolutas como "/static/...",
# "/styles/..." y "/manifest.json", y los assets caen fuera de la ruta proxiada
# devolviendo index.html (text/html). Resultado: el browser rechaza JS/CSS por MIME.
MINIO_BROWSER_REDIRECT_URL=https://YOUR_DOMAIN/acervo/console
MINIO_SERVER_URL=https://YOUR_DOMAIN/acervo
MINIO_PROMETHEUS_AUTH_TYPE=public/jwt
MINIO_BUCKETS=bucket1 bucket2 bucket3

BACKUP_DIR=path
BACKUP_RETENTION_MONTHS=number
